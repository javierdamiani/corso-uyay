/* Neue Plak
   -------------------------------------------------------------------------- */

@font-face {
  font-family: "Neue Plak";
  src: url("./NeuePlak-Light.woff2") format("woff2");
  font-weight: 300;
  font-style: normal;
  font-display: swap;
}

